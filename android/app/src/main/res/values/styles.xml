<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/brandBackground</item>

        <!-- Inset the web view below the status bar and above the navigation
             bar. Without this the page draws underneath both. -->
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:statusBarColor">@color/brandSystemBar</item>
        <item name="android:navigationBarColor">@color/brandSystemBar</item>

        <!-- The bars are dark, so their icons need to stay light. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:datePickerDialogTheme">@style/BrandDialog</item>
        <item name="android:timePickerDialogTheme">@style/BrandDialog</item>
        <item name="android:alertDialogTheme">@style/BrandDialog</item>
        <item name="alertDialogTheme">@style/BrandDialog</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brandBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/brandSystemBar</item>
        <item name="android:navigationBarColor">@color/brandSystemBar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Native dialogs the web view opens: date pickers, select lists and
         alerts. Pinned dark with explicit text colours so they never inherit
         the phone's light palette. -->
    <style name="BrandDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:textColorPrimary">@color/dialogTextPrimary</item>
        <item name="android:textColorSecondary">@color/dialogTextSecondary</item>
        <item name="android:colorBackground">@color/dialogSurface</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:colorAccent">@color/colorAccent</item>
    </style>
</resources>
